# Provider keys: only needed for real model runs (make eval, make up-real). Never needed for mock runs or CI.
ANTHROPIC_API_KEY=...
OPENAI_API_KEY=...

# Webhook shared secret (openssl rand -hex 32). Compose defaults to dev-only-webhook-secret if unset.
WEBHOOK_SECRET=...

# Gateway admin key, also used as the demo GATEWAY_KEY. Compose defaults to sk-dev-only-master if unset.
# Set a real one (openssl rand -hex 32, must start with sk-) for anything beyond a laptop.
# LITELLM_MASTER_KEY=sk-...

# Gateway database password. Compose defaults to dev-only-password if unset.
# POSTGRES_PASSWORD=...

# Shared Redis for several gateway instances (rate limits, cooldowns). Used by `make up-ha`.
# redis://[:password@]host:port  (use rediss:// for TLS). Unset = the local dev Redis.
# REDIS_URL=redis://:your-password@your-redis-host:6379